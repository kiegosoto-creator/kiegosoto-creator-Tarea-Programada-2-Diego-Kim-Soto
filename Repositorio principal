#Importaciones necesarias.
import pickle
import tkinter
import os
#Defino el nnombre de la base de datos.
ARCHIVO="datos_casino"
#Funciones para cargar y guardar
def cargar():
    """
    #
    """
    try:
        with open(ARCHIVO,'rb') as archivo:
            lista_jugadores=pickle.load(archivo)
            return lista_jugadores
    except FileNotFoundError:
        return []
#
def guardar(lista_jugadores):
    """
    #
    """
    with open(ARCHIVO,'wb') as archivo:
        pickle.dump(lista_jugadores,archivo)
#
jugadores=cargar()
