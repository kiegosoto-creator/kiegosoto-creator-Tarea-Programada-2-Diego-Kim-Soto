#Importaciones necesarias.
import pickle

#Base de datos
ARCHIVO = "datos_casino"

#Funciones cargar y guardar
def cargar():
    """
    Retorna la base de datos del archivo
    Si no lo encuentra, retorna lista vacia
    """
    try:
        with open(ARCHIVO, 'rb') as archivo: #Abre el archivo en modo lectura binaria('rb').
            lista_jugadores = pickle.load(archivo)
            return lista_jugadores
    except FileNotFoundError: #Si el archivo o existe, retorna lista vacia.
        return []

def guardar(lista_jugadores):
    """
    Guarda una lista de jugadores en la base de datos
    """
    with open(ARCHIVO, 'wb') as archivo: #Abre el archivo en modo escritura binaria('wb')
        pickle.dump(lista_jugadores, archivo)

#Registro de jugadores...
def agregar_jugador(lista_jugadores, username, nombre, apellido):
    """
    Valida y agrega un nuevo jugador a la lista de jugadores
    Retorna True si lo registra, y False si no lo registra por algun problema.
    """
    #"Limpio"(marcas de cuotacion, o sea no literlamnete limpiar) los nombres dados.
    username=username.strip()
    nombre=nombre.strip()
    apellido=apellido.strip()
    #Esto se hace para validar que no esten vacios.
    if not username or not nombre or not apellido:
        print("Ningun campo puede estar vacio")
        return False
    #Valido que no se repita el nombre de usuario en la lista de jugadores, y uso 'any'
    if any(jugador[0][0].lower() == username.lower() for jugador in lista_jugadores):
        print("El nombre de usuario ya esta siendo usado por otro jugador")
        return False
    #Al pasar previos 2 filtros, Crea al jugador
    nuevo_jugador=[(username, nombre, apellido),[0.0,0,0,0,0],0]
    #Agrega nuevo jugador a la lista, y guarda.
    lista_jugadores.append(nuevo_jugador)
    guardar(lista_jugadores)
    return True

#Inicio de session
def iniciar_sesion(lista_jugadores, username_ingresado):
    """
    Busca e un jugador por nombre de usuario.
    Retorna el jugador si existe, y si no retorna None.
    """
    #"Limpio el nombre ingresado."
    username_ingresado=username_ingresado.strip()
    #Reviso que no este vacio
    if not username_ingresado:
        return None
    #Revisa si existe jugador
    for jugador in lista_jugadores:
        if jugador[0][0].lower()==username_ingresado.lower():
            return jugador #Retornadatos de jugador si los nombreees de usuario son iguales.
    #Si no lo encuentra retorna None.
    return None

#Fichas...
VALOR_FICHAS={"rojo":10,"azul":50,"verde":20,"blanco":5}

def comprar_fichas(jugador, cant_rojas, cant_azules, cant_verdes, cant_blancas):
    """
    Cuando el usuario trata de comprar fichas, Retorna True si funciona la compra, y
    False si no le alcansa.
    """
    #VAlido que no sean negativos, un error como no revisar podria ser explotado.
    if cant_rojas<0 or cant_azules<0 or cant_verdes<0 or cant_blancas<0:
        return False
    #Calculo el costo total de las fichas con la base de datos de VALOR_FICHAS
    costo_total=(cant_rojas*VALOR_FICHAS["rojo"])+\
                (cant_azules*VALOR_FICHAS["azul"])+\
                (cant_verdes*VALOR_FICHAS["verde"])+\
                (cant_blancas*VALOR_FICHAS["blanco"])
    #Si NO le alcanza al usuario
    if jugador[1][0]<costo_total:
        return False #Retorna False y  nada mas pasa.
    #Pero si le alcanza, subtrae el costo total de las fichas, y agrega las fichas.
    jugador[1][0]-=costo_total
    jugador[1][1]+=cant_rojas
    jugador[1][2]+=cant_azules
    jugador[1][3]+=cant_verdes
    jugador[1][4]+=cant_blancas
    #Retorna True al funcionar.
    return True

def canjear_fichas(jugador, cant_rojas, cant_azules, cant_verdes, cant_blancas):
    """
    Cuando el usuario canjea las fichas por dinero, retorna True si funciona, Y False si no.
    """
    if cant_rojas<0 or cant_azules<0 or cant_verdes<0 or cant_blancas<0:
            return False
    #Una ves maz alido que no awa negaticov
    if (jugador[1][1] < cant_rojas or
        jugador[1][2] < cant_azules or
        jugador[1][3] < cant_verdes or
        jugador[1][4] < cant_blancas):
        return False
    #Calculo cuanto dinero se recive or las fichas
    dinero_total=(cant_rojas*VALOR_FICHAS["rojo"])+\
                 (cant_azules*VALOR_FICHAS["azul"])+\
                 (cant_verdes*VALOR_FICHAS["verde"])+\
                 (cant_blancas*VALOR_FICHAS["blanco"])
    #Vendo las fichas
    jugador[1][1]-=cant_rojas
    jugador[1][2]-=cant_azules
    jugador[1][3]-=cant_verdes
    jugador[1][4]-=cant_blancas
    #Rcive el dinero
    jugador[1][0]+=dinero_total
    #Retorna True porquw funciomo
    return True

