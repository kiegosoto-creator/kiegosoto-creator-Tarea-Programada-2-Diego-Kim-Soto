#Importaciones necesarias.
import pickle

#Base de datos
ARCHIVO = "datos_casino"

#Funciones cargar y guardar
def cargar():
    """
    Retorna la base de datos del archivo
    Si no lo encuentra, retorna lista vacia
    """
    try:
        with open(ARCHIVO, 'rb') as archivo: #Abre el archivo en modo lectura binaria('rb').
            lista_jugadores = pickle.load(archivo)
            return lista_jugadores
    except FileNotFoundError: #Si el archivo o existe, retorna lista vacia.
        return []

def guardar(lista_jugadores):
    """
    Guarda una lista de jugadores en la base de datos
    """
    with open(ARCHIVO, 'wb') as archivo: #Abre el archivo en modo escritura binaria('wb')
        pickle.dump(lista_jugadores, archivo)

